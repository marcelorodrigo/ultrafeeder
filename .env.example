# UltraFeeder + FR24 — Environment Variables
# =============================================
# Copy values into the Portainer stack Environment panel.
# Do NOT commit this file with real values.

# --- Identity & Location (REQUIRED) ---
FEEDER_NAME=ultrafeeder-pi3          # Shown to aggregators; also the tar1090 page title
FEEDER_TZ=Europe/Amsterdam           # Container timezone
FEEDER_LAT=51.505                    # Placeholder — override with real coordinates
FEEDER_LONG=5.391                    # Placeholder — override with real coordinates
FEEDER_ALT_M=10                      # Antenna altitude in metres above mean sea level

# --- SDR Hardware ---
ADSB_SDR_SERIAL=1090                 # iSerial from `lsusb -v -d 0bda:2838 | grep iSerial`
ADSB_SDR_PPM=0                       # Frequency correction — set to 0, tune later if needed
READSB_GAIN=auto                     # Gain: auto, or a numeric value (e.g. 49.6)

# --- UUIDs & Sharing Keys (REQUIRED) ---
MULTIFEEDER_UUID=                    # Generate with: uuidgen — set before deployment
ADSBX_UUID=                          # Your ADS-B Exchange sharing UUID
FR24_SHARING_KEY=                    # Your Flightradar24 sharing key
AIRNAVRADAR_SHARING_KEY=             # Your AirNav Radar (rbfeeder) sharing key
